{
  "name": "slop-goblin",
  "version": "1.0.0",
  "private": true,
  "description": "A goblin that eats LinkedIn buzzwords, gets fatter with every bite and spits out plain English. A zero-dependency bookmarklet.",
  "type": "module",
  "homepage": "https://slopgoblin.pharmatools.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickjlamb/slop-goblin.git"
  },
  "bugs": "https://github.com/nickjlamb/slop-goblin/issues",
  "author": "Nick Lamb (https://www.pharmatools.ai)",
  "license": "MIT",
  "keywords": ["bookmarklet", "linkedin", "buzzwords", "jargon", "plain-english", "browser-toy", "satire"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "examples": "node examples/gen-before-after.mjs",
    "diagram": "python3 docs/gen_diagram.py",
    "slopify": "node examples/slopify.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "terser": "^5.31.0"
  }
}
